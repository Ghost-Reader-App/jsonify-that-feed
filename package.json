{
  "name": "jsonify-that-feed",
  "version": "1.2.2",
  "description": "A simple library for turning Atom, RSS and JSON feeds into JSON Feed.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "npm run lint && mocha tests/**/*.js",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/Ghost-Reader-App/jsonify-that-feed#readme",
  "repository": "https://github.com/Ghost-Reader-App/jsonify-that-feed",
  "author": "Sayem Chowdhury",
  "keywords": [
    "rss",
    "json",
    "opml",
    "feed",
    "parser",
    "atom",
    "sy",
    "syndication",
    "xml"
  ],
  "license": "MIT",
  "private": false,
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "html-entities": "2.6.0",
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mime-types": "3.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "mocha": "12.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
